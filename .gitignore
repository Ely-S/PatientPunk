# IDE
.project
.pydevproject
.idea/
*.iml
.vscode/
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.env

# Runtime data — do not commit data files. Store them externally
# (PatientPunk_data/ + S3) and provide download instructions in the README.
data/*
!data/.gitkeep
output/
*.zip

# Sample / scraped corpus data (user histories, subreddit posts, extraction outputs)
reddit_sample_data/
reddit_posts_only/
Scrapers/users/
Scrapers/output/
**/subreddit_posts.json

# Dev scratch
**/_manual_check_tmp/

# LLM API response cache (content-addressable)
cache/

# Pipeline intermediate / temp files
**/temp/
**/patientpunk_records_*.json
**/merged_records_*.json
**/llm_records_*.json
**/discovered_records_*.json
**/discovered_field_report_*.json
**/extraction_metadata_*.json
**/phase1_candidates.json

# Run-specific database provenance stays beside external data, never in Git.
**/*_provenance.yaml

# Database files
*.db

# Local-only agent config + session notes (not code, not versioned in this repo).
# AGENTS.md and CLAUDE.md are versioned; put personal Claude Code notes in CLAUDE.local.md.
.cursorrules
CONTINUITY.md
CLAUDE.local.md

# Run/scratch output dirs (data + intermediates — keep in PatientPunk_data/ + S3, never commit)
output_*/
compare/
compare_par/
outputs/

# IRR pilot sample packs — verbatim patient text + analyst-only answer keys.
# Kept in gitignored data/ + S3 and distributed to coders privately; never tracked.
studies/rct_validation/irr_pilot/ai_labels.csv
studies/rct_validation/irr_pilot/coding_input.csv

# Baseline Check working data: post text, coded posts, page drafts. Kept locally only.
studies/baseline_check/**/*.json
studies/baseline_check/**/*.jsonl
studies/baseline_check/**/*.txt
studies/baseline_check/**/*.html
studies/baseline_check/**/node_modules/
!studies/baseline_check/**/package.json
!studies/baseline_check/**/package-lock.json
# Hand-coded rows written as Python; they quote posts.
studies/baseline_check/v02_analysis/b[0-9].py
studies/baseline_check/v02_analysis/coded/b[0-9].py
studies/baseline_check/v02_analysis/quality/c[0-9]*.py
studies/baseline_check/v02_analysis/coverage/themes.py
