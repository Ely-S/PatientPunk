# PatientPunk — shared environment variables
# Copy this file to .env and fill in your keys.
#
# Both pipelines default to OpenRouter (set OPENROUTER_API_KEY); they fall back
# to ANTHROPIC_API_KEY, or set LLM_PROVIDER=anthropic to force the Anthropic API.
#   - variable_extraction/ (Shaun's pipeline — regex + LLM extraction)
#   - src/ (sentiment + demographics pipeline)

# --- OpenRouter (default provider for both pipelines) ---
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Anthropic (fallback, or force with LLM_PROVIDER=anthropic below) ---
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=XXX

# To use the Anthropic API directly instead of OpenRouter, uncomment:
# LLM_PROVIDER=anthropic

# Model overrides (optional — defaults to current Claude models).
# Any model supported by your provider works via OpenRouter:
#   google/gemini-2.0-flash, openai/gpt-4o, meta-llama/llama-3.1-70b-instruct, etc.
# MODEL_FAST=anthropic/claude-haiku-4.5
# MODEL_STRONG=anthropic/claude-sonnet-4.6

# --- Dispersed (GPU compute) — to LAUNCH a vLLM node via dispersed/launch_job.py ---
# API keys from your Dispersed account (https://dispersed.com). launch_job.py
# HMAC-signs each request with these; after launch it prints the LLM_BASE_URL to
# set below. (Not needed if you already have an endpoint to point at.)
# DISPERSED_PUBLIC_KEY=pk_...
# DISPERSED_SECRET_KEY=sk_...

# --- Custom / dispersed endpoint ---
# Anthropic-compatible gateway: just set LLM_BASE_URL (provider stays
# anthropic/openrouter) + the model(s) above.
# OpenAI-compatible server (vLLM / Ollama on a dispersed GPU node): set
# LLM_PROVIDER=openai + LLM_BASE_URL + MODEL_FAST/MODEL_STRONG to the served model.
# Needs the openai client:  pip install 'patientpunk[openai]'
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY                       # vLLM/Ollama usually ignore the key
# Match the model your endpoint actually serves. dispersed/vllm.Dockerfile serves
# the AWQ build below (fits 24-32 GB); Ollama's default tag is qwen2.5:32b.
# MODEL_FAST=Qwen/Qwen2.5-32B-Instruct-AWQ
# MODEL_STRONG=Qwen/Qwen2.5-32B-Instruct-AWQ

# --- Determinism ---
# Sampling temperature for ALL LLM calls. Default 0.0 = deterministic/reproducible
# (recommended for a research dataset and for fair model A/B comparisons).
# LLM_TEMPERATURE=0
