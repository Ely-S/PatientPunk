# LLM API configuration
# Default: OpenRouter (lets you switch models without code changes)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# To use Anthropic directly instead, uncomment these:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here

# To use Dispersed (https://api.dispersed.com) — distributed GPU compute
# serving open-source models via vLLM — uncomment these:
# LLM_PROVIDER=dispersed
# DISPERSED_PUBLIC_KEY=your_dispersed_public_key_here   # pk_...
# DISPERSED_SECRET_KEY=your_dispersed_secret_key_here   # sk_...
# DISPERSED_RECIPE_FAST=<recipe-uuid>      # PERSISTENT vLLM recipe for Qwen/Qwen3-8B
# DISPERSED_RECIPE_STRONG=<recipe-uuid>    # PERSISTENT vLLM recipe for Qwen/Qwen3-32B
# DISPERSED_FALLBACK=openrouter            # optional: fall back when a job can't start
#
# Recipe setup (out-of-band, do this once via the Dispersed UI):
#   - image: vllm/vllm-openai:latest
#   - GPU: 16 GB VRAM for Qwen3-8B, 64 GB for Qwen3-32B
#   - command: `vllm serve <model> --port 8000`
# Copy each recipe's UUID into the env vars above.

# Model overrides (optional — defaults depend on provider)
# OpenRouter examples (any OpenRouter-supported model works):
#   google/gemini-2.0-flash, openai/gpt-4o, meta-llama/llama-3.1-70b-instruct
# Dispersed: the model name must match what `vllm serve` is loading
#   (e.g. Qwen/Qwen3-8B, Qwen/Qwen3-32B)
# MODEL_FAST=anthropic/claude-haiku-4.5
# MODEL_STRONG=anthropic/claude-sonnet-4.6
