# PatientPunk — shared environment variables
# Copy this file to .env and fill in your keys.
#
# Both pipelines default to OpenRouter (set OPENROUTER_API_KEY); they fall back
# to ANTHROPIC_API_KEY, or set LLM_PROVIDER=anthropic to force the Anthropic API.
#   - variable_extraction/ (Shaun's pipeline — regex + LLM extraction)
#   - src/ (sentiment + demographics pipeline)

# --- OpenRouter (default provider for both pipelines) ---
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Anthropic (fallback, or force with LLM_PROVIDER=anthropic below) ---
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=XXX

# To use the Anthropic API directly instead of OpenRouter, uncomment:
# LLM_PROVIDER=anthropic

# Model overrides (optional — defaults to current Claude models).
# Any model supported by your provider works via OpenRouter:
#   google/gemini-2.0-flash, openai/gpt-4o, meta-llama/llama-3.1-70b-instruct, etc.
# MODEL_FAST=anthropic/claude-haiku-4.5
# MODEL_STRONG=anthropic/claude-sonnet-4.6
