# PatientPunk — shared environment variables
# Copy this file to .env and fill in your keys.
#
# Used by:
#   - variable_extraction/ (Shaun's pipeline — regex + LLM extraction; uses Anthropic directly)
#   - src/ (sentiment + demographics pipeline — uses OpenRouter by default)

# --- Anthropic (used by variable_extraction/) ---
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=XXX

# --- LLM config for the src/ pipeline ---
# Default: OpenRouter (lets you switch models without code changes)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# To use Anthropic directly for src/ instead, uncomment:
# LLM_PROVIDER=anthropic

# Model overrides (optional — defaults to Anthropic Claude).
# Any model supported by your provider works via OpenRouter:
#   google/gemini-2.0-flash, openai/gpt-4o, meta-llama/llama-3.1-70b-instruct, etc.
# MODEL_FAST=anthropic/claude-haiku-4.5
# MODEL_STRONG=anthropic/claude-sonnet-4.6
